// Lean tool sets generated by Token Optimizer.
// Fewer tools => fewer tool definitions and smaller tool outputs per request.
{
  "plan-readonly": {
    "tools": ["codebase","search","usages","fetch","githubRepo","findTestFiles","problems","changes"],
    "description": "Read-only tools for planning",
    "icon": "search"
  },
  "implement-lean": {
    "tools": ["codebase","search","usages","editFiles","runCommands","runTasks","findTestFiles","problems","changes"],
    "description": "Lean tools for implementing an approved plan",
    "icon": "tools"
  }
}
